# Code Atlas configuration. Copy to .env and edit:  cp .env.example .env
#
# Everything runs locally in Docker. Only the LLM calls go out, to the Anthropic API.

# ---------------------------------------------------------------------------
# Anthropic API key (required)
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Models
#
# Any Anthropic model ID works. The query model answers questions; the index
# model writes the file/folder summaries (that is where most of the cost is, so
# a cheaper model is a reasonable choice there).
#
# Optional settings below are only sent when they are not blank, because models
# differ in what they accept:
#   claude-sonnet-5-5, claude-opus-5-5, claude-haiku-5-5
#       EFFORT: low | medium | high | xhigh | max     TEMPERATURE: leave blank (400 error otherwise)
#       THINKING: blank (default) | adaptive | between_tools
#                 (between_tools is how Sonnet 5.5 turns thinking off; needs EFFORT high or lower)
#   claude-haiku-4-5, claude-sonnet-4-5 (older)
#       EFFORT: leave blank (not supported)           TEMPERATURE: allowed
#       THINKING: leave blank
# Thinking tokens count toward MAX_TOKENS, so keep it generous on 5.x models.
# ---------------------------------------------------------------------------

# Question answering
QUERY_MODEL=claude-sonnet-5-5
QUERY_MAX_TOKENS=32000
QUERY_EFFORT=medium
QUERY_THINKING=
QUERY_TEMPERATURE=

# Indexing (summaries)
INDEX_MODEL=claude-sonnet-5-5
INDEX_MAX_TOKENS=24000
INDEX_EFFORT=low
INDEX_THINKING=
INDEX_TEMPERATURE=
INDEX_TIMEOUT_SECONDS=300
# Retries the Anthropic SDK performs on rate limits and transient errors
# (report and the other commands; sync leaves retries to Temporal)
INDEX_API_MAX_RETRIES=5
# File or folder summaries sync generates at a time (its Temporal sliding window).
# Lower this if you hit rate limits (429s). Replaces INDEX_MAX_WORKERS (default was 8).
INDEX_WINDOW_SIZE=10

# Prices (USD per million tokens), used only for the indexer's cost report.
# Update these to match INDEX_MODEL. Defaults are Sonnet 5.5; Haiku 4.5 is 1.00 / 5.00.
INDEX_PRICE_INPUT_PER_1M=2.00
INDEX_PRICE_OUTPUT_PER_1M=10.00
# Prompt-cache reads as a fraction of the input price: 0.05 on the 5.5 models, 0.1 on most others.
INDEX_PRICE_CACHE_READ_MULTIPLIER=0.05

# ---------------------------------------------------------------------------
# What the indexer skips
#
# Comma-separated list. A file is skipped if ANY pattern matches it. Patterns:
#   name/       a folder with that name at any depth      node_modules/
#   a/b/        a folder path, at the root or nested       docs/build/
#   *.ext       no slash: matched against the file name    *.png   Makefile   .gitignore
#   a/*.txt     has a slash: matched against the whole     src/generated/*
#               repo-relative path ("*" also matches "/")
# Wildcards: * (anything), ? (one character), [abc] (one of these characters).
#
# INDEX_EXCLUDE replaces the built-in list below (this value IS the built-in
# list, so edit it freely). If you remove the line or leave it blank, the
# built-in list is used. To keep the defaults and just add more, use
# INDEX_EXCLUDE_EXTRA instead of editing INDEX_EXCLUDE.
#
# Files are also skipped when they are binary (not valid UTF-8), not regular
# files, or larger than INDEX_MAX_FILE_BYTES. .gitignore is not consulted:
# anything committed to git is a candidate unless listed here.
#
# Changing these does not remove already-indexed files immediately: newly
# excluded files drop out of the index on the next incremental run.
# ---------------------------------------------------------------------------
INDEX_EXCLUDE=__pycache__/,.claude/,.cursor/,.git/,.github/,.venv/,.vscode/,build/,dist/,node_modules/,vendor/,venv/,.dockerignore,.gitattributes,.gitignore,.gitmodules,*.crt,*.gif,*.gz,*.idx,*.jpg,*.key,*.lock,*.log,*.map,*.min.js,*.pack,*.pem,*.png,*.pyc,*.pdf,*.rev,*.sample,*.sum,*.svg,*.tar.gz,*.zip
# Extra patterns on top of the list above, for example: tests/,docs/,*.csv,*.json
INDEX_EXCLUDE_EXTRA=
# Largest file (in bytes) that is indexed. 1000000 = 1 MB
INDEX_MAX_FILE_BYTES=1000000

# ---------------------------------------------------------------------------
# Temporal lens
#
# When on, every file, folder and repository summary also gets a Temporal lens
# record: durable-execution signals and concepts from the Temporal knowledge pack,
# used to assess Temporal suitability. Turning it on costs roughly a few dollars
# per thousand files on top of normal indexing. When on, every index run first
# checks the Temporal Docs MCP and stops if it is not reachable (see
# scripts/mcp_login.py).
# ---------------------------------------------------------------------------
LENS_ENABLED=true
# Knowledge pack (defaults to the copy built into the image)
LENS_PACK_PATH=
# Temporal Docs MCP endpoint and the credentials file written by scripts/mcp_login.py
# (as seen inside the indexer container)
TEMPORAL_DOCS_MCP_URL=https://temporal.mcp.kapa.ai
TEMPORAL_DOCS_MCP_CREDENTIALS=/run/code-atlas/temporal-docs-mcp.json

# ---------------------------------------------------------------------------
# Temporal report (scripts/report.sh)
#
# The report investigates each process in the indexed code (reading the index
# and the mirrored source) before scoring it. Investigation runs at
# REPORT_EFFORT; the report's other calls use the INDEX_* model settings.
# ---------------------------------------------------------------------------
REPORT_EFFORT=medium
# Scoring rubric (defaults to the copy built into the image)
REPORT_RUBRIC_PATH=

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
# Database name prefix. The indexer and the web app must agree (default is fine).
# Each repository becomes a database named <prefix>_<name>.
DB_PREFIX=semv2

# ---------------------------------------------------------------------------
# Temporal (sync runs as a workflow on the dev server in compose.yaml)
# ---------------------------------------------------------------------------
# compose.yaml sets TEMPORAL_ADDRESS (temporal:7233), TEMPORAL_NAMESPACE and
# TEMPORAL_UI_URL for the containers. Host ports, bound to localhost only:
TEMPORAL_PORT=7233
# Temporal UI (indexing runs): http://localhost:8233
TEMPORAL_UI_PORT=8233

# ---------------------------------------------------------------------------
# Indexing from the UI
#
# The UI's folder picker offers repositories under this folder. compose mounts it
# read-only into the app and the indexing worker at the same path, so paths are the
# ones on your machine. Blank means your home directory.
# ---------------------------------------------------------------------------
REPOS_ROOT=

# ---------------------------------------------------------------------------
# Chat sessions (one Temporal workflow per conversation; tokens via Redis)
# ---------------------------------------------------------------------------
# A session ends after this long without a message; the next message starts a new
# one from the conversation your browser keeps.
CHAT_IDLE_HOURS=24
# Characters of conversation sent to the model (oldest messages dropped first).
CHAT_CONTEXT_CHARS=240000
CHAT_TURN_TIMEOUT_MINUTES=20
CHAT_STREAM_TTL_SECONDS=3600
CHAT_MAX_CONCURRENT_TURNS=16

# ---------------------------------------------------------------------------
# Business impact ("Business impact" in the Temporal report view, on demand)
#
# Uses the INDEX_* model settings, as the report does. The customer context you
# enter is sent to the model and stored in the index's database, never in
# Temporal workflow history.
# ---------------------------------------------------------------------------
# temporal: each run is a workflow on the impact-worker service. inprocess: a thread
# of the app instead (a stopgap when Temporal is unavailable; an app restart loses the run).
IMPACT_RUNNER=temporal
# Activities the impact worker runs at once.
IMPACT_CONCURRENCY=4
# How code facts map to business consequences and cost formulas (defaults to the copy
# built into the image). Its default cost inputs are placeholders to review.
IMPACT_MAPPING_PATH=

# ---------------------------------------------------------------------------
# Web app
# ---------------------------------------------------------------------------
# Host port for the UI (bound to localhost only): http://localhost:8090
# Change it if something else already uses 8090 (a clash can show another app's page).
APP_PORT=8090
# Host port for Compass Web (browse the stored indexes; bound to localhost only): http://localhost:8096
COMPASS_PORT=8096
# debug | info | warning | error  (query side)
LOG_LEVEL=INFO
